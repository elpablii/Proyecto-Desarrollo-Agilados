# Variables de entorno para el proyecto
# Copia este archivo a .env y configura los valores según tu entorno

# Token de autenticación opcional para la API externa de mallas
# Si no se proporciona, el sistema funcionará en modo demo/local
HAWAII_AUTH=

# Entorno de ejecución de Node.js
NODE_ENV=production

# Puerto del backend (por defecto 3001)
PORT=3001
